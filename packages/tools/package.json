{
  "name": "@freeweight/tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only EVM token toolkit and a stateless Streamable-HTTP MCP handler, built for Cloudflare Workers.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "record": "tsx scripts/record-fixtures.ts && tsx scripts/trim-fixtures.ts"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
